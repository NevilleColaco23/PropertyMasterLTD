{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "AccessLogWorker/Dockerfile"
  },
  "deploy": {
    "startCommand": "dotnet AccessLogConsumerWorker.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
