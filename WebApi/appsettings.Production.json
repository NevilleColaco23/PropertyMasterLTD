{
  "AzureKeyVaultSettings": {
    "AddToConfiguration": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SwaggerSettings": {
    "ApiName": "MyWarehouse",
    "UseSwagger": false,
    "LoginPath": "/account/oauth2/access_token"
  },
  "AuthenticationSettings": {
    "JwtIssuer": "MyWarehouse",
    "JwtAudience": "MyWarehouse",
    "TokenExpirationSeconds": 86400
  },
  "ApplicationDbSettings": {
    "AutoMigrate": false,
    "AutoSeed": false
  },
  "CorsSettings": {
    "AllowedOrigins": []
  },
  "LogglySettings": {
    "WriteToLoggly": false
  },
  "TestRabbitMq": {
    "ScriptPath": ".\\test-rabbitmq.ps1"
  }
}
