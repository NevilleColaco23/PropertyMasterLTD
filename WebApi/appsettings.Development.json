{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "PricingDb": "PricingDb",
    "MongoDb": "MongoDb",
    "Redis": "Redis"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=YourDatabaseName;Trusted_Connection=True;",
    "PricingDb": "Data Source=localhost;Integrated Security=True;Initial Catalog=PricingDb;Connection Timeout=120",
    "MongoDb": "<AZURE_MONGODB_CONNECTION_STRING>",
    "Redis": "machost:6379"
  },
  "SwaggerSettings": {
    "UseSwagger": true
  },
  "AuthenticationSettings": {
    "JwtIssuer": "MyWarehouse",
    "JwtAudience": "MyWarehouse",
    "TokenExpirationSeconds": 86400,
    // Secret: JwtSigningKeyBase64
    "JwtSigningKeyBase64": "<SET_VIA_USER_SECRETS_OR_ENVIRONMENT>"
  },
  "ApplicationDbSettings": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "ExternalAuthenticationSettings": {
    // Secret: GoogleClientId configured via user-secrets or Azure App Settings
    "GoogleClientId": null
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "FrontendSettings": {
    "BaseUrl": "http://localhost:4200"
  },
  "LogglySettings": {
    "WriteToLoggly": false
  },
  "ServiceBus": {
    "ConnectionString": "<AZURE_SERVICE_BUS_CONNECTION_STRING>",
    "AccessLogQueueName": "app-queue",
    "EmailQueueName": "email-queue"
  }
}
